# Copy to .env and fill in. Never commit .env.

# ---- the app ----
PORT=8787
APP_URL=http://localhost:5173     # where the web app is served (redirect target after sign-in)
SERVER_URL=http://localhost:8787  # public URL of this server (OAuth callbacks)
# APP_ORIGINS=https://bots.example.com  # other addresses the app is opened from (comma-separated), e.g. a public hostname in front of APP_URL
SESSION_SECRET=change-me-to-a-long-random-string   # REQUIRED: replace with `openssl rand -hex 32`; the server refuses this placeholder. Also signs the agents' /mcp tokens
DEV_LOGIN=0                       # 1 enables email-only sign-in; only works when APP_URL is localhost and the request comes from this machine
ALLOWED_EMAILS=                   # comma-separated emails allowed to sign in; empty = anyone while APP_URL is localhost, nobody on a public URL
# ---- sign-in through Cloudflare Access (optional; see README "Signing in") ----
# CF_ACCESS_TEAM_DOMAIN=          # your Access team, e.g. myteam (= https://myteam.cloudflareaccess.com)
# CF_ACCESS_AUD=                  # the Access application's Application Audience (AUD) tag
# CF_ACCESS_ACCOUNTS=             # access@x=account@y,... when an Access address should sign in to an account made under another address
# DISPLAY_NAMES=                  # address=Name,... names shown for who is signed in: a person's Access address, or an account's own (e.g. owner@x=Alex & Sam)
# SCOPED_PEOPLE=                  # person@x=BotName|Other,...: that person's sign-in sees only those bots (a family member's simple view)
# CF_ACCESS_APP_URL=              # the address behind Access, shown on the sign-in page of other addresses
# CF_ACCESS_PHONE_TOKENS=         # you@example.com=/etc/cleftbot/phone-access/you.env,...: that person's "Sign in another device" codes use CF_ACCESS_APP_URL plus their phone's Access service token, so phones work without a VPN
OWNER_EMAIL=                      # the account whose bot gets the agent that already runs on the computer (its memory, messaging, main screen); empty = anyone while APP_URL is localhost, nobody on a public URL
# HOST=0.0.0.0                    # interface to listen on; unset = 127.0.0.1 while APP_URL is localhost, otherwise all interfaces
# DB_PATH=./data/cleftbot.db      # where the app keeps its SQLite database (an existing data/bothq.db or data/grokbot.db is still used)
# ALLOW_EMPTY_DB=1                 # start on a database with no accounts even though one with accounts sits beside it (a deliberate fresh start)
# DB_SNAPSHOTS_KEEP=14             # daily database copies kept in data/snapshots (0 = off); Settings > System shows them
# DB_SNAPSHOTS_DIR=                # another folder for those copies

# ---- the agents (Hermes) ----
HERMES_BIN=hermes                 # the hermes CLI; it starts one gateway per extra bot
HERMES_URL=http://127.0.0.1:8642  # API server of the agent that already runs (the first bot)
# HERMES_HOME_PRIMARY=~/.hermes   # that agent's home (memory files, .env with API_SERVER_KEY)
# HERMES_KEY=                     # its API key, when not readable from <home>/.env
# ENGINES_DIR=./data/engines      # homes of the extra bots; must be outside ~/.hermes
# ENGINE_PORT_BASE=8650
# MCP_BASE_URL=http://127.0.0.1:8787   # how the agents reach this server; must be a loopback address, /mcp refuses calls from anywhere else
# EXTRA_MCP_SERVERS=              # JSON object of Hermes mcp_servers entries; served as approval-checked apps (extra-<name>)
# PRIMARY_BOT_NAME=Doug
# PRIMARY_BOT_LABEL=Chief of Staff

# ---- the bots' screens ----
# COMPUTER=local (default without an Orgo key): one virtual display per bot on this machine (Xvfb,
# a window manager, x11vnc for the live view); scripts/setup-local.sh installs them. COMPUTER=orgo
# uses an Orgo cloud computer instead (then ORGO_API_KEY and ORGO_COMPUTER_ID are needed).
COMPUTER=local
# LOCAL_RESOLUTION=1280x800
# LOCAL_STATE_DIR=/var/lib/cleft-bot/computer   # default: data/computer in the repo
# PRIMARY_CDP_URL=http://127.0.0.1:9333   # a Chrome the first bot already owns on the default screen
MAX_BOTS=4
# ORGO_API_KEY=                   # only for COMPUTER=orgo
# ORGO_COMPUTER_ID=

# ---- connected apps: local MCP servers (see docs/local-apps.md) ----
# APPS_CONFIG=./apps.json         # default: apps.json in the repo root (copy apps.example.json)
# MS365_CLIENT_ID=                # your Entra app registration, used by apps.example.json's m365 entry
# MS365_TENANT_ID=

# ---- voice: a local speech server with the OpenAI audio API (see docs/voice.md) ----
VOICE_URL=http://127.0.0.1:8000/v1
# VOICE_STT_MODEL=Systran/faster-distil-whisper-small.en
# VOICE_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# VOICE_TTS_VOICE=af_heart
# The call voice from Phonon instead of Kokoro (see docs/voice.md, "Phonon"):
# VOICE_TTS_ENGINE=phonon
# VOICE_TTS_URL=http://127.0.0.1:8880/v1
# VOICE_TTS_VOICE=Easton
# VOICE_APPROVALS=1               # answer approval cards by saying yes or no on a call

# ---- optional: research on X (the x_search tool); off when empty, nothing is sent to xAI ----
XAI_API_KEY=
XAI_MODEL=grok-4.7

# ----- Plugins installed through the app (docs/plugins.md) -----
# Where installed plugins live (default ./data/plugins).
# PLUGINS_DIR=
# Container runtime and image for installed plugins.
# PLUGIN_RUNTIME=docker
# PLUGIN_RUNTIME_IMAGE=node:22-slim
# Allow installing from a local .tgz (the AI plugin builder needs this).
# PLUGINS_ALLOW_LOCAL_TARBALLS=0
# Ask before Hermes runs its own tools (terminal, files, browser) in managed bots. 0 turns it off.
# HERMES_GATE=1

# Siloed bots (docs/sheldon-silo.md): a bot whose agent runs in its own container. The app calls it
# but never starts, configures or deletes it, and checks every message it sends to another bot.
# Key by bot id, or "name:<Bot name>" so the bot is siloed from the moment it is created.
# SILO_BOTS={"name:Sheldon":{"url":"http://127.0.0.1:8653","keyFile":"/etc/cleft-bot/silo/sheldon/secrets/api_key","vnc":"127.0.0.1:5953","vncPasswordFile":"/etc/cleft-bot/silo/sheldon/secrets/vnc_password","allow":{"Leonard":["CAL","ITINERARY","RECEIPT","Q","A"]}}}
# SILO_BOTS_FILE=

# Outside members (docs/sheldon-link.md): a bot that lives elsewhere and is reached through Slack.
# OUTSIDE_BOTS={"name:Sheldon":{"via":"slack","slackUserId":"U0123ABCD","channel":"C0123ABCD","channelName":"assistants","replyMinutes":75,"ownerName":"Alex","aliases":{"Claude":"Leonard"}}}
# OUTSIDE_BOTS_FILE=
# SLACK_USER_TOKEN_FILE=/etc/cleft-bot/slack/user_token
# SLACK_APP_TOKEN_FILE=/etc/cleft-bot/slack/app_token
# SLACK_POST_VIA=mcp   # post via Slack's MCP server (app needs MCP server access on), so ChatGPT agents wake
