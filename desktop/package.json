{
  "name": "cleftbot-desktop",
  "productName": "YBots",
  "version": "0.13.0",
  "private": true,
  "description": "YBots for Windows: a thin Electron window around the YBots web app.",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tests/syntax.mjs && node --test tests/policy.test.mjs tests/remote-core.test.mjs tests/shell.test.mjs tests/update.test.mjs",
    "test:e2e": "node tests/electron-e2e.mjs",
    "dist:win": "electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.1",
    "png2icons": "^2.0.1",
    "resedit": "^3.1.1"
  },
  "build": {
    "appId": "com.yancey.cleftbot.desktop",
    "productName": "YBots",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "YanceyBot",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "afterPack": "build/after-pack.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/myanceyiii/ybots.git"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "ws": "8.22.2",
    "yauzl": "3.4.0"
  }
}
