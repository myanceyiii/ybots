# /etc/systemd/system/sheldon-mcp-relay.service
# Passes only Sheldon's /mcp calls from its gate container to the app (see the script's header).
[Unit]
Description=Cleft Bot: Sheldon MCP relay
After=network-online.target docker.service

[Service]
EnvironmentFile=/etc/cleft-bot/silo/sheldon/relay.env
ExecStart=/usr/bin/python3 /usr/local/lib/cleft-bot/sheldon-mcp-relay.py
DynamicUser=yes
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=128M

[Install]
WantedBy=multi-user.target
