{
  "display_information": {
    "name": "Cleft",
    "description": "Lets the Cleft bots talk with Sheldon in #assistants."
  },
  "oauth_config": {
    "scopes": {
      "user": ["chat:write", "channels:history", "channels:read"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "user_events": ["message.channels"]
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
